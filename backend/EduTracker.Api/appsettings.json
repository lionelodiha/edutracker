{
  "ConnectionStrings": {
    "Database": "REPLACE_WITH_YOUR_DATABASE_CONNECTION_STRING",
    "Redis": "REPLACE_WITH_YOUR_REDIS_CONNECTION_STRING"
  },
  "Hashing": {
    "EmailHmacKey": "REPLACE_WITH_A_SECURE_RANDOM_STRING",
    "PasswordWorkFactor": 12
  },
  "DataEncryption": {
    "Key": "REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY"
  },
  "SessionManagement": {
    "StandardSessionDurationHours": 8,
    "ExtendedSessionDurationDays": 7,
    "AbsoluteSessionLimitDays": 90,
    "StandardExpiryExtensionHours": 1,
    "ExtendedExpiryExtensionHours": 12,
    "ExpiryExtensionTriggerPercent": 5
  },
  "SessionTokens": {
    "SecretKey": "REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY",
    "Issuer": "EduTracker",
    "Audience": "EduTrackerUsers",
    "AccessTokenExpirationMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}