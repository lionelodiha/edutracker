{
  "ConnectionStrings": {
    "Database": "Host=<YOUR_DB_SERVER>;Port=<YOUR_DB_PORT>;Username=<YOUR_DB_USER>;Password=<YOUR_DB_PASSWORD>;Database=<YOUR_DB_NAME>;",
    "Redis": "<YOUR_REDIS_HOST_AND_PORT>[, password=<YOUR_REDIS_PASSWORD_IF_ANY>]"
  },
  "DataEncryptionOptions": {
    "CurrentKeyVersion": 1,
    "Keys": {
      "1": "<YOUR_ENCRYPTION_KEY_BASE64>"
    }
  },
  "HashingOptions": {
    "EmailHmacKey": "<YOUR_ENCRYPTION_KEY_BASE64>",
    "PasswordWorkFactor": 12
  },
  "SessionLifetimeOptions": {
    "StandardSessionDuration": {
      "Hours": 8
    },
    "ExtendedSessionDuration": {
      "Hours": 168
    },
    "AbsoluteSessionLimit": {
      "Hours": 2160
    },
    "StandardExpiryExtension": {
      "Hours": 1
    },
    "ExtendedExpiryExtension": {
      "Hours": 12
    },
    "ExpiryExtensionTriggerPercent": 5
  },
  "StreamBufferOptions": {
    "MaxEventsPerUser": 200,
    "RetentionMinutes": 5
  },
  "CacheTimeToLiveOptions": {
    "Session": {
      "Minutes": 10
    },
    "UserAuthState": {
      "Minutes": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Connection": "None"
    }
  },
  "AllowedHosts": "*"
}
