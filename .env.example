# EduTracker backend — container secrets.
# Copy to `.env` (gitignored, never commit the real one):
#   Copy-Item .env.example .env
#
# The `api` service in docker-compose.yml reads this file via `env_file`.
# Your `dotnet user-secrets` values are NOT visible inside the container,
# so every secret below must be set here.
#
# Generate fresh 32-byte Base64 keys (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))

# AES-256 data-encryption key. MUST decode to exactly 32 bytes.
DataEncryptionOptions__Keys__1=<YOUR_BASE64_32_BYTE_DATA_KEY>

# Email HMAC key. MUST be Base64 decoding to at least 32 bytes.
# (A second, different key from the one above is recommended.)
HashingOptions__EmailHmacKey=<YOUR_BASE64_32_BYTE_PLUS_HMAC_KEY>

# Bootstrap super-admin (created at startup if it does not exist).
# NOTE: leave MiddleName out entirely — an empty value fails validation,
# while an absent one is treated as null and passes.
SuperAdminSeedOptions__FirstName=Admin
SuperAdminSeedOptions__LastName=Super
SuperAdminSeedOptions__UserName=admin
SuperAdminSeedOptions__Email=admin@example.com
SuperAdminSeedOptions__Password=ChangeMe!123
